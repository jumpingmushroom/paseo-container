#!/command/with-contenv bash
set -euo pipefail
LOG_TAG="04-agents"
# shellcheck source=rootfs/usr/local/lib/paseo-container/common.sh
source /usr/local/lib/paseo-container/common.sh

export HOME="$USER_HOME"
export PATH="${AGENT_PREFIX}/bin:/usr/local/bin:/usr/bin:/bin"

if [ -n "${APT_PACKAGES:-}" ]; then
    log "installing APT_PACKAGES: ${APT_PACKAGES}"
    # shellcheck disable=SC2086 # APT_PACKAGES holds a space-separated package
    # list that must word-split into individual apt-get arguments.
    if apt-get update -qq \
        && apt-get install -y --no-install-recommends ${APT_PACKAGES}; then
        rm -rf /var/lib/apt/lists/*
    else
        # A bad package name must not stop the container from booting.
        warn "APT_PACKAGES install failed; continuing"
    fi
fi

install_agent() {
    local name="$1"
    local installer="${AGENT_LIB_DIR}/${name}.sh"

    if [ ! -f "$installer" ]; then
        warn "unknown agent '${name}': no installer at ${installer}; skipping"
        local known="" f
        for f in "${AGENT_LIB_DIR}"/*.sh; do
            [ -e "$f" ] || continue
            known="${known}$(basename "$f" .sh) "
        done
        warn "known agents: ${known}"
        return 0
    fi

    # Each installer runs in a subshell so its function definitions cannot
    # leak into the next one.
    (
        # shellcheck source=/dev/null
        source "$installer"

        # Credential links must exist before the installer runs, so an
        # installer that writes settings during setup writes into /config.
        # This script runs as root, so anything link_persist creates is
        # root-owned; the agent itself runs as paseo, so each path is claimed
        # here rather than waiting for the recursive chown at the end of this
        # script, which lands after the installer has already run.
        while IFS= read -r rel; do
            [ -n "$rel" ] || continue
            link_persist "${AGENT_PREFIX}/state/${rel}" "${USER_HOME}/${rel}"
            chown -h "${PUID:-99}:${PGID:-100}" "${USER_HOME}/${rel%/}"
            # A file persist path has no /config side yet: link_persist
            # leaves it for the agent's own first write to create.
            if [ -e "${AGENT_PREFIX}/state/${rel%/}" ]; then
                chown -h "${PUID:-99}:${PGID:-100}" \
                    "${AGENT_PREFIX}/state/${rel%/}"
            fi
        done < <(agent_persist_paths)

        if [ "${AGENT_UPDATE:-0}" != "1" ] && agent_installed; then
            log "${name}: already installed ($(agent_version || echo 'version unknown'))"
        else
            if agent_installed; then
                log "${name}: reinstalling because AGENT_UPDATE=1"
            else
                log "${name}: installing"
            fi

            if agent_install; then
                log "${name}: installed ($(agent_version || echo 'version unknown'))"
            else
                # A failed agent install must not stop Paseo and sshd from
                # starting.
                warn "${name}: install failed; continuing without it"
            fi
        fi
    )
}

# HOME_PERSIST names home-directory paths that tools other than the agents
# keep their configuration in: gh's credentials under .config/gh, the
# OpenStack client's .config/openstack/clouds.yaml, kubeconfig, talosconfig.
# The home directory is not persisted, so without a link each of those is
# lost on every recreate. These links run before any agent installs, for the
# same reason the agents' own persist paths do.
#
# You write each entry relative to home. A trailing "/" marks a directory,
# and an entry without one marks a file. The loop normalizes every entry
# first, then refuses any it cannot link safely: an empty entry, ".", an
# absolute path, a path with a ".." segment, and the share's mount point or
# anything above or below it. Linking the share would delete your
# repositories or abort the boot, so the loop warns and moves on instead.
#
# An entry equal to or inside an earlier one is skipped with a warning too:
# once .config/ is linked, .config/gh/ already lives in /config, and linking
# it a second time would point it at itself.
HOME_PERSIST="${HOME_PERSIST-.config/ .kube/ .talos/}"
share_rel="${WORKSPACE_DIR#"${USER_HOME}"/}"
accepted_rels=()
accepted_entries=()
while IFS= read -r entry; do
    case "$entry" in
        /*) warn "HOME_PERSIST: ignoring '${entry}': must be relative to home"; continue ;;
    esac
    rel="$(printf '%s' "$entry" | tr -s '/')"
    while [ "${rel#./}" != "$rel" ]; do rel="${rel#./}"; done
    while [ "${rel%/.}" != "$rel" ]; do rel="${rel%/.}"; done
    while [ "${rel//\/.\//\/}" != "$rel" ]; do rel="${rel//\/.\//\/}"; done
    slash=""
    case "$rel" in
        */) slash="/" ;;
    esac
    rel="${rel%/}"
    case "$rel" in
        ""|.) warn "HOME_PERSIST: ignoring '${entry}': names the home directory itself"; continue ;;
    esac
    case "/${rel}/" in
        */../*) warn "HOME_PERSIST: ignoring '${entry}': must not contain '..'"; continue ;;
    esac
    case "${rel}/" in
        "${share_rel}"/*) warn "HOME_PERSIST: ignoring '${entry}': is or is inside the share"; continue ;;
    esac
    case "${share_rel}/" in
        "${rel}"/*) warn "HOME_PERSIST: ignoring '${entry}': contains the share"; continue ;;
    esac
    covered=""
    for i in "${!accepted_rels[@]}"; do
        case "${rel}/" in
            "${accepted_rels[$i]}"/*) covered="${accepted_entries[$i]}"; break ;;
        esac
    done
    if [ -n "$covered" ]; then
        warn "HOME_PERSIST: ignoring '${entry}': already persisted under '${covered}'"
        continue
    fi
    accepted_rels+=("$rel")
    accepted_entries+=("$entry")
    link_persist "${CONFIG_DIR}/home/${rel}${slash}" "${USER_HOME}/${rel}"
    chown -h "${PUID:-99}:${PGID:-100}" "${USER_HOME}/${rel}"
    if [ -e "${CONFIG_DIR}/home/${rel}" ]; then
        chown -h "${PUID:-99}:${PGID:-100}" "${CONFIG_DIR}/home/${rel}"
    fi
done < <(printf '%s\n' "$HOME_PERSIST" | tr -s '[:space:]' '\n' | sed '/^$/d')

AGENTS="${AGENTS-claude}"
if [ -z "$AGENTS" ]; then
    log "AGENTS is empty; installing no agents"
else
    IFS=',' read -r -a agent_list <<< "$AGENTS"
    for raw in "${agent_list[@]}"; do
        name="$(printf '%s' "$raw" | tr -d '[:space:]')"
        [ -n "$name" ] || continue
        install_agent "$name" || warn "${name}: installer aborted; continuing"
    done
fi

chown -R "${PUID:-99}:${PGID:-100}" "$AGENT_PREFIX" "${CONFIG_DIR}/home"
chown_home "${PUID:-99}:${PGID:-100}"
log "ready"
